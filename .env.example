# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
# Tài khoản chỉ đọc cho API (tối thiểu 8 ký tự — yêu cầu của Neo4j).
NEO4J_READER_USER=reader
NEO4J_READER_PASSWORD=readerpass
NEO4J_DATABASE=neo4j

# ---- LLM (Gemini free tier: gemini-3.5-flash-lite = 15 RPM / 500 RPD) ----
GEMINI_API_KEY=
# Groq free tier: openai/gpt-oss-20b = 30 RPM / 1000 RPD
GROQ_API_KEY=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TEMPERATURE=0.0

# ---- Dữ liệu ----
DUMP_VERSION=
WIKI_LANG=vi

# ---- Ứng dụng ----
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
SEED=42
